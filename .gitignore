# ==================================================================
# 1️⃣ SISTEM OPERASI & IDE EDITOR
# ==================================================================
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

# ==================================================================
# 2️⃣ KEAMANAN & RAHASIA (WEB SECURITY STANDARD) 🔒
# ==================================================================
# Memblokir semua file environment variabel agar password/API Key tidak bocor
.env
.env.*
!.env.example    # KECUALI .env.example (Wajib di-push sebagai cetakan)

# Memblokir sertifikat SSL dan kunci privat (Sangat rahasia!)
*.pem
*.key
*.crt
*.p12
secrets/

# Memblokir database lokal agar data pengguna tidak ikut terunggah
*.db
*.sqlite3

# ==================================================================
# 3️⃣ DEPENDENCIES & PACKAGES (Mencegah Repository Terlalu Berat)
# ==================================================================
# Frontend (Node.js)
node_modules/
/frontend/node_modules/

# Backend (Go & Python)
vendor/
/backend/vendor/
__pycache__/
*.pyc
.venv/
env/

# ==================================================================
# 4️⃣ HASIL BUILD & DOCKER ARTEFAK
# ==================================================================
# Frontend Vite/React hasil build
dist/
build/
/frontend/dist/
/frontend/build/

# Backend Go binary hasil compile (diperbaiki dari list Anda)
*.exe
obelms-server     # Nama binary Go Anda di Dockerfile
/backend/obelms-server

# Docker data local (jika ada volume lokal)
.docker/

# ==================================================================
# 5️⃣ USER UPLOADS & LOGS
# ==================================================================
# Memblokir folder upload agar gambar/dokumen user di lokal tidak masuk ke Git
/backend/uploads/
uploads/

# Log file
*.log
npm-debug.log*
yarn-error.log

# ==================================================================
# 6️⃣ TEMPORARY FILES & CACHE
# ==================================================================
.cache/
*.tmp
*.temp
*.bak
