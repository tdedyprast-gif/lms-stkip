# ------------------------------------------------------------------
# 1️⃣ Sistem Operasi & Editor
# ------------------------------------------------------------------
.DS_Store                # macOS
Thumbs.db                # Windows
ehthumbs.db
Desktop.ini
.idea/                   # JetBrains IDE (IntelliJ, PyCharm, WebStorm)
.vscode/                 # VS Code
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------
# 2️⃣ File Konfigurasi & Rahasia
# ------------------------------------------------------------------
.env                     # variabel lingkungan (API key, password, dll.)
.env.*                   # varian .env (contoh .env.local)
*.secret
*.pem                    # kunci privat
*.key
*.crt
*.p12
config/*.yml              # jika ada file konfigurasi berisi kredensial
secrets/                 # folder khusus untuk secret (jangan push)

# ------------------------------------------------------------------
# 3️⃣ Build / Distribusi
# ------------------------------------------------------------------
/dist/                   # hasil build (JS, CSS, dll.)
/build/
/out/
/target/
*.class                  # file bytecode Java
*.jar
*.war
*.ear
*.exe
*.dll
*.so
*.dylib

# ------------------------------------------------------------------
# 4️⃣ Dependency Direktori
# ------------------------------------------------------------------
node_modules/
vendor/
bower_components/
*.egg-info/
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3               # database SQLite yang di‑generate

# ------------------------------------------------------------------
# 5️⃣ Log & Temporary Files
# ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log
*.tmp
*.temp
tmp/
temp/
*.bak
*.swp
*.swo

# ------------------------------------------------------------------
# 6️⃣ Test & Coverage
# ------------------------------------------------------------------
coverage/
*.lcov
*.lcov.report.*
/test-output/
*.spec.ts
*.spec.js

# ------------------------------------------------------------------
# 7️⃣ Dokumentasi Otomatis & Artefak
# ------------------------------------------------------------------
/docs/_site/
*.docx
*.pdf

# ------------------------------------------------------------------
# 8️⃣ Miscellaneous yang Tidak Perlu Di‑Git
# ------------------------------------------------------------------
*.cache
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.old
*.orig
